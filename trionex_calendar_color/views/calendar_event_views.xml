<?xml version="1.0" ?>
<odoo>
    <record id="view_calendar_event_calendar" model="ir.ui.view">
        <field name="model">calendar.event</field>
        <field name="inherit_id" ref="calendar.view_calendar_event_calendar" />
        <field name="arch" type="xml">
            <calendar position="attributes">
                <attribute name="color">color</attribute>
            </calendar>
            <field name="categ_ids" position="after">
                <field name="color" invisible="1"/>
            </field>
        </field>
    </record>

    <record id="calendar_event_view_inherit_form" model="ir.ui.view">
        <field name="name">calendar.event.color.inherit.form</field>
        <field name="model">calendar.event</field>
        <field name="inherit_id" ref="calendar.view_calendar_event_form"/>
        <field name="arch" type="xml">
            <!-- Apply partner_color integer to calendar events -->
            <xpath expr="//field[@name='categ_ids']" position="after">
                <field name="color" widget="color" invisible="1"/>
            </xpath>
        </field>
    </record>
</odoo>
