<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>

        <record id="account_payment_form_stripe_inherit" model="ir.ui.view">
            <field name="name">account.payment.form.stripe.inherit</field>
            <field name="model">account.payment</field>
            <field name="inherit_id" ref="account.view_account_payment_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='payment_method_line_id']" position="after">
                    <field name="stripe_payment_status" readonly="1"
                           invisible="payment_method_line_id != 5"
                           widget="badge"
                           decoration-success="stripe_payment_status == 'paid'"
                           decoration-danger="stripe_payment_status == 'failed'"
                           decoration-warning="stripe_payment_status == 'in_progress'"
                           decoration-info="stripe_payment_status == 'draft'"/>
                    <field name="stripe_failure_reason" readonly="1" invisible="stripe_payment_status != 'failed'"/>
                    <field name="stripe_payment_intent_id" readonly="1"
                           invisible="payment_method_line_id != 5"/>
                </xpath>
            </field>
        </record>

        <record id="payment_provider_form_stripe_inherit" model="ir.ui.view">
            <field name="name">payment.provider.form.stripe.inherit</field>
            <field name="model">payment.provider</field>
            <field name="inherit_id" ref="payment.payment_provider_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='state']" position="after">
                    <field name="terminal_reader_id" invisible="code != 'stripe'" password="True"/>
                </xpath>
            </field>
        </record>

        <record id="view_move_form_inherit_custom_payments" model="ir.ui.view">
            <field name="name">account.move.form.inherit.custom.payments</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <xpath expr="//div[@name='button_box']" position="inside">
                    <button name="action_view_custom_payments"
                            type="object"
                            class="oe_stat_button"
                            invisible="custom_payment_counts == 0"
                            icon="fa-money">
                        <div class="o_stat_info">
                            <field name="custom_payment_counts" widget="statinfo" string="Payments"/>
                        </div>
                    </button>
                </xpath>
                <xpath expr="//header/button[@name='action_register_payment']" position="attributes">
                    <attribute name="invisible">custom_payment_counts > 0 and amount_residual == 0</attribute>
                </xpath>
                <xpath expr="//group[@id='header_right_group']/field[@name='currency_id']" position="after">
                    <field name="is_stripe_payment" string="Stripe Payment" readonly="1" invisible="1"/>
                </xpath>
                <xpath expr="//widget[2]" position="replace">
                    <widget name="web_ribbon"
                            title="Paid by Stripe"
                            bg_color="bg-success"
                            invisible="not is_stripe_payment or payment_state != 'in_payment' or move_type not in ('out_invoice', 'out_refund', 'in_invoice', 'in_refund', 'out_receipt', 'in_receipt')"/>
                    <widget name="web_ribbon"
                            title="In Payment"
                            bg_color="bg-success"
                            invisible="is_stripe_payment or payment_state != 'in_payment' or move_type not in ('out_invoice', 'out_refund', 'in_invoice', 'in_refund', 'out_receipt', 'in_receipt')"/>
                </xpath>
            </field>
        </record>

        <record id="view_payment_wizard_form_inherit_custom_payments" model="ir.ui.view">
            <field name="name">account.payment.register.form.inherit.custom.payments</field>
            <field name="model">account.payment.register</field>
            <field name="inherit_id" ref="account.view_account_payment_register_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='journal_id']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
            </field>
        </record>

        <template id="report_invoice_document_stripe_inherit" inherit_id="account.report_invoice_document">
            <xpath expr="//div[@name='incoterm_id']" position="after">
                <t t-if="o.is_stripe_payment" name="stripe_payment_ribbon">
                    <div style="position: absolute; top: 0px; right: 120px; width: 200px; height: 300px;">
                        <div style="position: absolute; top: 50px; right: -30px; width: 240px; text-align: center; background: #28a745; color: white; font-size: 20px; font-weight: bold; padding: 7px 0; border-radius: 50px;">
                            Paid by Stripe
                        </div>
                    </div>
                </t>
            </xpath>
        </template>

    </data>
</odoo>
