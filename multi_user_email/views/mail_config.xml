<odoo>
    <data>
        <record id="mail_config_form_view" model="ir.ui.view">
            <field name="name">mail.config.form.view</field>
            <field name="model">mail.config</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <group>
                                <field name="mail_server_id" options="{'no_create': True, 'no_open':True}"/>
                            </group>
                            <group>
                                <field name="user_id" options="{'no_create': True}"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="mail_config_tree_view" model="ir.ui.view">
            <field name="name">mail.config.tree.view</field>
            <field name="model">mail.config</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="user_id"/>
                    <field name="mail_server_id"/>
                </tree>
            </field>
        </record>

        <record id="mail_config_action" model="ir.actions.act_window">
            <field name="name">Mail Config</field>
            <field name="res_model">mail.config</field>
            <field name="view_mode">tree,form</field>
        </record>

        <menuitem id="mail_config_menu" name="Mail Config" action="mail_config_action" parent="base.menu_email"/>

    </data>
</odoo>
