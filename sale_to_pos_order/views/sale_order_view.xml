<odoo>
    <record id="view_order_form_inherit_sale_to_pos" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.sale.to.pos</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="create_pos_order"
                        type="object"
                        string="Create POS Order"
                        class="oe_highlight"
                        invisible="state != 'sale'"/>
            </xpath>
        </field>
    </record>
</odoo>